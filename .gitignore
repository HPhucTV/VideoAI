# ==============================================================================
# OmniVideo Studio - Production Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local Environment Variables & Sensitive Credentials (STRICTLY FORBIDDEN)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*
*.env
!*.env.example
!*.env.*.example

# OAuth2 Tokens & API Client Secrets
client_secrets*.json
*client_secret*.json
token*.json
*token*.json
credentials*.json
*credential*.json
service_account*.json
workshops/workshop-cinematic/youtube/channels/**/token*.json
workshops/workshop-cinematic/youtube/channels/**/client_secrets*.json
workshops/workshop-cinematic/uploaded_mids.json
workshops/workshop-cinematic/agent/active_project.json
workshops/workshop-cinematic/flow_session_project.json
workshops/workshop-cinematic/series_manifest.json

# Private Keys, Certificates & Auth Sessions
*.pem
*.key
*.pfx
*.p12
*.crt
*.cert
*.id_rsa
*.id_ed25519
*.session
*.cookie
cookies.json
session.json
.npmrc
.pypirc

# Database state files
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# ------------------------------------------------------------------------------
# 2. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
core/node_modules/
workshops/*/node_modules/
package-lock.json

# ------------------------------------------------------------------------------
# 3. Python Virtual Environments, Bytecode & Testing Caches
# ------------------------------------------------------------------------------
.venv/
*/.venv/
workshops/*/.venv/
venv/
env/
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.pyd
.pytest_cache/
*/.pytest_cache/

# ------------------------------------------------------------------------------
# 4. Core, TTS & Workshop Runtime Caches
# ------------------------------------------------------------------------------
core/cache/
tts-cache/
*/tts-cache/
*/*/tts-cache/
*/*/*/tts-cache/
.cache/
*.cache
cache/
*/cache/
*/*/cache/
scratch/
*/scratch/
.stitch/
*/.stitch/
.omc/
*/.omc/
.agent/
*/.agent/
dashboard/data/
dashboard/public/audio/
*.backup.*
*.bak

# ------------------------------------------------------------------------------
# 5. Ephemeral Render Outputs & Media Files
# ------------------------------------------------------------------------------
*.mp4
*.mkv
*.mov
*.avi
output/**/*.mp4
output/**/*.mp3
output/**/*.wav
output/**/*.m4a
output/**/*.aac
output/**/*.png
output/**/*.jpg
output/**/*.jpeg
output/**/*.gif
output/**/*.webp
output/news/*
output/explainer/*
output/whiteboard/*
output/blender/*
output/cinematic/*
output/threads/*
output/thumbnails/*
!output/news/.gitkeep
!output/explainer/.gitkeep
!output/whiteboard/.gitkeep
!output/blender/.gitkeep
!output/cinematic/.gitkeep
!output/threads/.gitkeep
!output/thumbnails/.gitkeep
!output/jobs/
!output/jobs/*.json
!output/jobs/.gitkeep

# ------------------------------------------------------------------------------
# 6. Workshop Ephemeral Build Artifacts
# ------------------------------------------------------------------------------
workshops/*/output/
workshops/flowkit-main.zip
*.zip
*.tar.gz
workshops/workshop-explainer/output/
workshops/workshop-explainer/public/audio/
workshops/workshop-explainer/public/props.json
workshops/workshop-explainer/test-still.png
workshops/workshop-explainer/dist/
workshops/workshop-explainer/build/
workshops/workshop-explainer/.remotion/
workshops/workshop-whiteboard/preview.html

# ------------------------------------------------------------------------------
# 7. OS, Editor & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------------------------------------------
# 8. Heavy 3D Binaries
# ------------------------------------------------------------------------------
*.glb
*.gltf
*.fbx
*.obj
*.vrm
workshops/workshop-blender/assets/characters/**/*.glb
workshops/workshop-blender/assets/characters/**/*.vrm
!workshops/workshop-blender/assets/characters/**/config.json
!workshops/workshop-blender/assets/characters/**/LICENSES.md

# ------------------------------------------------------------------------------
# 9. Logs & Diagnostics
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
