# ══════════════════════════════════════════════════════════════════════════════
# OMNIVIDEO STUDIO - CẤU HÌNH HỆ THỐNG TRUNG TÂM LOCAL (.env.example)
# ══════════════════════════════════════════════════════════════════════════════
# HƯỚNG DẪN:
# Sao chép (copy) file này thành file tên ".env" tại cùng thư mục và điền giá trị.
# Các trường để trống là tùy chọn (optional). Dự án chạy được ngay 100% miễn phí
# với Microsoft Edge-TTS mà không bắt buộc phải mua bất kỳ API Key nào!
# ══════════════════════════════════════════════════════════════════════════════

# ── 1. CẤU HÌNH GIỌNG ĐỌC AI (TTS) ─────────────────────────────────────────────
# Mặc định: edge-tts (Hoàn toàn miễn phí 0đ, không cần API Key, không giới hạn)
# Lựa chọn: "edge-tts" | "vbee" | "lucylab" | "elevenlabs"
TTS_PROVIDER=edge-tts

# Cấu hình Microsoft Edge TTS tiếng Việt chuẩn Studio 48kHz
# Giọng Nam trầm ấm: vi-VN-NamMinhNeural (Mặc định)
# Giọng Nữ truyền cảm: vi-VN-HoaiMyNeural
EDGE_TTS_VOICE=vi-VN-NamMinhNeural
EDGE_TTS_RATE=+5%
EDGE_TTS_PITCH=+0Hz
EDGE_TTS_VOLUME=+0%

# Cấu hình Vbee (Nếu bạn có tài khoản Vbee.vn trả phí - tùy chọn)
VBEE_APP_ID=
VBEE_ACCESS_TOKEN=
VBEE_VOICE_CODE=n_hanoi_male_protrainer_education_vc
VBEE_SPEED_RATE=1.0

# Cấu hình ElevenLabs (Nếu bạn có tài khoản ElevenLabs trả phí - tùy chọn)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ── 2. CẤU HÌNH THƯƠNG HIỆU & KÊNH (BRANDING) ─────────────────────────────────
CHANNEL_NAME="KÊNH CÔNG NGHỆ & BÀI HỌC"
TIKTOK_HANDLE="@videostudio.local"
TIKTOK_DISPLAY_NAME="Video AI Studio"

# ── 3. THÔNG SỐ RENDER CHUẨN ──────────────────────────────────────────────────
# Chuẩn khung hình: 30 FPS mặc định (nhẹ máy, render nhanh gấp 2 lần 60fps)
DEFAULT_FPS=30
VIDEO_THEME=dark-neon

# ── 4. ĐƯỜNG DẪN HỆ THỐNG TẬP TRUNG ───────────────────────────────────────────
CACHE_DIR=core/cache/tts
SHARED_ASSETS_DIR=shared-assets
OUTPUT_DIR=output

# ── 5. CẤU HÌNH THÔNG BÁO TELEGRAM (TÙY CHỌN) ──────────────────────────────────
# Nhận báo cáo ca trực và tiến độ render video trực tiếp qua Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 6. CẤU HÌNH GITHUB SCOUTING (TÙY CHỌN) ────────────────────────────────────
# Token để quét các repo GitHub Trending không bị giới hạn rate limit (tùy chọn)
GITHUB_TOKEN=

# ── 7. CẤU HÌNH FLOWKIT & GOOGLE AI (TÙY CHỌN - XƯỞNG 4 ĐIỆN ẢNH) ──────────────
FLOWKIT_AGENT_URL=http://127.0.0.1:8100
FLOW_PROJECT_ID=
GEMINI_API_KEY=
